# Passerelle Agrivalor Dispatch — copier en server/.env (jamais versionné)
#
# Le secret de l'application Entra ID (BC_TOKEN_CLIENT_ID / BC_TOKEN_CLIENT_SECRET)
# va dans le .env À LA RACINE. La passerelle s'en sert pour obtenir le token
# elle-même (pas besoin de Python) ; get_bc_token.py lit les mêmes variables.

PORT=8787

# --- Business Central (OData V4) ---
BC_TENANT_ID=ef2c50ef-b9e0-499b-a90d-d7b2399d6ec4
BC_ENVIRONMENT=Production
BC_COMPANY=SUNDGAU COMPOST
BC_TOURNEE_ENTITY=Tournee_Excel
BC_MISSION_ENTITY=Mission_Excel

# Fichier contenant le token d'accès (chemin relatif à la racine du dépôt).
BC_TOKEN_FILE=token.txt
# Facultatif : commande lancée pour renouveler le token si BC_TOKEN_CLIENT_ID /
# BC_TOKEN_CLIENT_SECRET ne sont pas renseignés (ex. python get_bc_token.py).
# Laisser vide sur le VPS, où le timer systemd produit déjà le token.
BC_TOKEN_COMMAND=

# --- Webfleet (pas encore branché) ---
# WEBFLEET_ACCOUNT=
# WEBFLEET_USERNAME=
# WEBFLEET_PASSWORD=
# WEBFLEET_APIKEY=
