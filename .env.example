# Agrivalor Dispatch — configuration (copier en .env.local)
#
# Sans valeur, l'application fonctionne en MODE DÉMONSTRATION (données fictives
# clairement signalées dans l'interface).
#
# URL d'une passerelle serveur (BFF) qui détient les identifiants Webfleet et
# Business Central et expose les routes décrites dans README.md.
# NE JAMAIS mettre de clé API Webfleet / Business Central dans une variable VITE_* :
# ces variables sont incluses dans le code envoyé au navigateur.
VITE_DISPATCH_API_URL=

# Fond de carte (tuiles raster XYZ). Par défaut : OpenStreetMap.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; contributeurs OpenStreetMap

# Actualisation automatique (secondes, 0 = désactivée). Minimum appliqué : 30 s.
VITE_REFRESH_INTERVAL_S=60
