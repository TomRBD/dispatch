{
  "name": "agrivalor-dispatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "server": "tsx server/index.ts",
    "bc:inspect": "tsx server/bc/inspect.ts",
    "webfleet:inspect": "tsx server/webfleet/inspect.ts",
    "live": "concurrently -k -n passerelle,appli -c green,blue \"npm:server\" \"vite --mode live\""
  },
  "dependencies": {
    "@fontsource/overpass": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "5.8",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
